# Server-side local repository catalog. The browser only receives opaque IDs.
FORGEFLOW_REPOSITORIES_FILE=var/repositories.json

# Fixed executable and bounded read-only Git operations.
FORGEFLOW_GIT_PATH=git.exe
FORGEFLOW_ENABLE_GIT_HTTP=false
FORGEFLOW_GIT_TIMEOUT_MS=5000
FORGEFLOW_MAX_TREE_ENTRIES=500
FORGEFLOW_MAX_BLOB_BYTES=1048576
FORGEFLOW_MAX_COMMITS=100
FORGEFLOW_STORAGE_ROOT=var/repositories
FORGEFLOW_MAX_REPOSITORIES=100
FORGEFLOW_IMPORT_ROOTS=var/repositories
FORGEFLOW_CATALOG_BOOTSTRAP=true

# Local metadata store. Production should use a managed PostgreSQL adapter.
FORGEFLOW_DB_PATH=var/forgeflow.sqlite
FORGEFLOW_DEV_USER_EMAIL=developer@forgeflow.local
FORGEFLOW_DEV_USER_NAME=Local Developer
# Keep both development-only login switches disabled in production.
FORGEFLOW_DISABLE_DEV_LOGIN=false
FORGEFLOW_ALLOW_DEV_LOGIN=false

# Production identity boundary. `none` exposes no production login flow; set
# `oidc` only after implementing and reviewing the provider callback.
FORGEFLOW_AUTH_PROVIDER=none
FORGEFLOW_OIDC_ISSUER=
FORGEFLOW_OIDC_CLIENT_ID=
FORGEFLOW_OIDC_CLIENT_SECRET=
# Test harness only; never set this in a deployed environment.
FORGEFLOW_E2E_TEST=false
FORGEFLOW_APP_ORIGIN=

# Optional provider-neutral AI transport. Leave unset to use the safe local
# mock provider. Credentials are server-only and must never reach the browser.
FORGEFLOW_AI_BASE_URL=
FORGEFLOW_AI_API_KEY=
FORGEFLOW_AI_MODEL=auto/coding
FORGEFLOW_AI_ALLOW_REPOSITORY_CONTEXT=false
FORGEFLOW_AI_DAILY_TOKEN_LIMIT=10000
